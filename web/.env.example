VITE_API_BASE_URL=http://localhost:8000

# Optional. Without it, map tiles fall back to raw OpenStreetMap (no key
# needed). Get a free key at carto.com/basemaps.
VITE_CARTO_API_KEY=

# Optional. Without it, the student Find page draws a straight line between
# checkpoints instead of a real path-following walking route. Get a free key
# at openrouteservice.org.
VITE_ORS_API_KEY=
